# Copia este archivo a .env.local y rellena los valores reales.

# Número de WhatsApp que recibe las solicitudes de compra (formato internacional, sin +).
NEXT_PUBLIC_WHATSAPP_NUMBER=521XXXXXXXXXX

# Supabase — crea un proyecto en https://supabase.com y copia estos valores
# desde Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
